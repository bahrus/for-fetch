{
  "name": "for-fetch",
  "version": "0.0.0",
  "description": "Base class for web components as a service",
  "main": "for-fetch.js",
  "keywords": [
    "web-components",
    "web-component",
    "custom-element",
    "custom-elements"
  ],
  "dependencies": {
    "idb-keyval": "6.2.2",
    "stream-orator": "0.0.25",
    "trans-render": "0.0.958"
