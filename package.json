    "spa-ssi": "0.0.12",
    "@playwright/test": "1.55.0",
    "@power-elements/json-viewer": "2.1.1"
  },
  "exports": {
    "./for-fetch.js": "./for-fetch.js",
    ".": "./index.js"
  },
  "scripts": {
